# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only. Never expose to the browser or prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SMS (46elks; sender name max 11 characters, no replies to a name)
ELKS_API_USERNAME=
ELKS_API_PASSWORD=
ELKS_FROM=AlRahma
# Email (Resend; verified sender address)
RESEND_API_KEY=
BROADCAST_FROM_EMAIL=
# WhatsApp (keep false until Meta setup is complete)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
# Enables the thank-you/reminder queue separately from manual broadcasts.
WHATSAPP_NOTIFICATIONS_ENABLED=false
CRON_SECRET=

# Public trust details (shown on the homepage/privacy page only when set)
NEXT_PUBLIC_ORG_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ADDRESS=
